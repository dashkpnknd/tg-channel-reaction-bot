[Unit]
Description=TG Channel Reaction Bot
After=network-online.target dialoghub.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tg-channel-reaction-bot
EnvironmentFile=/opt/tg-channel-reaction-bot/.env
ExecStart=/opt/tg-channel-reaction-bot/.venv/bin/python /opt/tg-channel-reaction-bot/app.py run
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

